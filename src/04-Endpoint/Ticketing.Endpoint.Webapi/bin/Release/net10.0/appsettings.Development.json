{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=TicketingDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

    "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:9341" }
      }
    ]
  },
  "Jwt": {
    "Issuer": "Ticketing.Api",
    "Audience": "Ticketing.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 14
  },
  "SeedUsers": {
    "Enabled": true,
    "Accounts": {
      "Agent2": {
        "Email": "agent2@ticketing.local",
        "LegacyEmail": "admin1@ticketing.local",
        "Role": "Agent"
      },
      "Agent3": {
        "Email": "agent3@ticketing.local",
        "LegacyEmail": "admin2@ticketing.local",
        "Role": "Agent"
      },
      "Agent1": {
        "Email": "agent1@ticketing.local",
        "Role": "Agent"
      },
      "User1": {
        "Email": "user1@ticketing.local",
        "Role": "User"
      },
      "User2": {
        "Email": "user2@ticketing.local",
        "Role": "User"
      },
      "User3": {
        "Email": "user3@ticketing.local",
        "Role": "User"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
